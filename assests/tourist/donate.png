: 11px; }

.menulinkx ul { display: flex; flex-wrap: wrap; }

.menulinkx li { color: rgb(255, 255, 255); padding: 0px; list-style: none; =
font-size: 13px; width: 25%; }

.menulinkx li a { color: rgb(255, 255, 255); padding: 5px 0px; list-style: =
none; font-size: 13px; display: inline-flex; align-items: center; text-deco=
ration: none; }

.logomtwht { width: 67%; padding: 10px 29px 0px 0px; }

.menulinkx a:hover { color: rgba(248, 249, 255, 0.88); text-decoration: und=
erline; }

.newftlogo { padding: 2px 0px 9px; }

.contenht { color: rgb(255, 255, 255); font-size: 13px; width: 100%; }

.hedingemt { padding: 10px 0px 15px; color: rgb(255, 255, 255); }

.apiconh { width: 43%; }

.qdrt { width: 40%; }

.qdrt img { width: 100%; }

.apiconh img { width: 90%; }

.logoandmtwht { width: 30%; padding: 0px 27px; }

.nhy { width: 30px; height: 3px; display: block; background: rgb(49, 131, 2=
37); margin: 8px 0px 0px; }

.logoqrmtwht { width: 15%; margin-left: auto; }

.novftlast { border-top: 0.5px solid rgb(74, 71, 71); padding: 8px 15px; }

.ndertimhgt { margin-left: auto; padding: 0px 20px; width: 42%; }

.logowhtyu { width: 21%; }

.neftr { background: rgb(255, 0, 0); padding: 2px 6px; font-size: 7px; text=
-transform: uppercase; margin: 0px 15px; border-radius: 2px; top: 11px; pos=
ition: absolute; transform: skew(-20deg); left: 52px; }

.ndertimhgt img { width: 100%; }

.logowhtyu img { width: 100%; }

