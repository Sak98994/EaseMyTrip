@charset "utf-8";

.eb_widget_box * { margin: 0px; padding: 0px; font-size: 12px; box-sizing: =
border-box; font-family: Poppins, sans-serif; }

.chat_box_button_prnt { position: fixed; bottom: 25px; right: 20px; z-index=
: 9998; }

.chat_box_button { box-shadow: rgba(33, 150, 243, 0.64) 0px 4px 12px 0px; p=
adding: 1.5px; border-radius: 100px; width: max-content; position: relative=
; cursor: pointer; background: conic-gradient(
    from var(--eva-border-angle) at 50% 50%,
    rgba(200, 210, 230, .15) 0deg,
    rgba(32, 147, 239, .7) 90deg,
    rgba(200, 210, 230, .15) 150deg,
    rgba(56, 189, 248, .6) 210deg,
    rgba(200, 210, 230, .15) 270deg,
    rgba(129, 140, 248, .55) 320deg,
    rgba(96, 185, 250, .6) 350deg,
    rgba(200, 210, 230, .15) 360deg
  ); animation: 8s linear 0s infinite normal none running evaBorderRotate; =
}

.chat_box_button_inner { background: rgb(238, 248, 255); border-radius: 100=
px; padding: 4px 24px 4px 4px; display: flex; align-items: center; gap: 8px=
; }

.chat_box_button img { width: 42px; height: 42px; }

.chat_box_button h4 { font-size: 20px; font-weight: 600; color: rgb(33, 150=
, 243); }

.chat_box_button p { color: rgb(24, 26, 27); font-size: 12px; }

.chat-box { width: min(469px, -40px + 100vw); background: radial-gradient(c=
ircle at 87% 60%, rgb(202, 242, 255) 0%, rgb(202, 242, 255) 25%, rgb(255, 2=
55, 255) 55%, rgb(255, 255, 255) 100%, rgb(255, 255, 255) 100%); border-rad=
ius: 18px; box-shadow: rgba(0, 0, 0, 0.1) 0px 5px 20px; overflow: hidden; p=
osition: fixed; bottom: 20px; right: 20px; z-index: 9999; opacity: 0; trans=
form: translateY(12px); visibility: hidden; pointer-events: none; will-chan=
ge: opacity, transform; transition: opacity 0.3s ease-out, transform 0.3s e=
ase-out, visibility 0.3s; }

.chat-box.open-from-bottom { transform: translateY(80px); }

.chat-box.open { opacity: 1; transform: translateY(0px); visibility: visibl=
e; pointer-events: auto; transition: opacity 0.3s ease-out, transform 0.3s =
cubic-bezier(0.22, 1, 0.36, 1), visibility; }

.chat-header { display: flex; justify-content: space-between; align-items: =
center; padding: 12px 15px; background: rgb(255, 255, 255); box-shadow: rgb=
a(0, 0, 0, 0.08) 0px 0px 12px 0px; }

.header-left { display: flex; align-items: center; gap: 10px; }

.bot-icon img { width: 38px; height: 38px; }

.title { display: flex; align-items: center; }

.title h5 { font-weight: 600; font-size: 16px; }

.ai { background: linear-gradient(96.36deg, rgb(12, 112, 204) 4.3%, rgb(33,=
 150, 243) 84.07%); color: rgb(255, 255, 255); font-size: 12px; padding: 0p=
x 9px; border-radius: 10px; margin-left: 5px; display: inline-flex; font-we=
ight: 500; height: max-content; line-height: 16px; position: relative; over=
flow: hidden; }

.ai::after { content: ""; position: absolute; top: 0px; left: -75%; width: =
50%; height: 100%; background: linear-gradient(120deg, transparent 0%, rgba=
(255, 255, 255, 0.55) 50%, transparent 100%); animation: 2s ease-in-out 0s =
infinite normal none running ai-glare; }

@keyframes ai-glare {=20
  0% { left: -75%; }
  100% { left: 150%; }
}

.sub-eva { font-size: 11px; color: rgb(0, 0, 0); }

.header-icons { display: flex; gap: 8px; }

.header-icons span { width: 32px; height: 32px; border-radius: 50%; display=
: flex; align-items: center; justify-content: center; font-size: 13px; back=
ground: linear-gradient(rgba(33, 150, 243, 0.1) 0%, rgba(33, 150, 243, 0.04=
3) 100%); cursor: pointer; }

.header-icons span img { width: 12px; }

.mt_6 { margin-top: 6px; }

.mt_8 { margin-top: 8px; }

.bx_spc { margin-top: 16px; }

.dt_tm { font-size: 8px; color: rgb(147, 147, 147); margin-left: 10px; }

.dt_tm span { padding: 0px 4px; position: relative; display: inline-flex; f=
ont-size: 10px; }

.dt_tm span:first-child { padding-left: 0px; font-size: 10px; }

.dt_tm span:first-child::before { content: ""; position: absolute; right: -=
2px; top: 50%; transform: translateY(-50%); height: 64%; background: rgb(14=
7, 147, 147); width: 1px; }

strong { font-weight: 600; }

.chat-body { padding-bottom: 15px; }

.eb-bubble-footer { display: flex; align-items: center; justify-content: sp=
ace-between; width: 100%; gap: 8px; padding: 4px 0px 0px; }

.eb-escape-chip { display: inline-flex; align-items: center; gap: 5px; padd=
ing: 4px 12px; background: rgb(255, 255, 255); color: rgb(37, 99, 235); fon=
t-size: 11px; font-weight: 600; border-radius: 20px; cursor: pointer; user-=
select: none; box-shadow: rgba(33, 150, 243, 0.15) 0px 2px 8px; border: 1.5=
px solid rgb(191, 219, 254); transition: background 0.15s, box-shadow 0.15s=
; white-space: nowrap; flex-shrink: 0; }

