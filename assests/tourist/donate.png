Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: https://css.emtcontent.com/common/new-emt-footer.css?v=new

@charset "utf-8";

html, body, p, ul, li { margin: 0px; padding: 0px; border: 0px; outline: 0p=
x; font-family: Poppins, sans-serif; }

.clr { clear: both; }

object { width: 100%; height: 571px; }

.ftnewnovmain { width: 100%; border-bottom: 0.5px solid rgb(74, 71, 71); pa=
dding: 8px 0px 10px; height: 322px; }

.flxwrp { flex-wrap: wrap; }

.neftbg { background: rgb(26, 26, 26); }

.ftnew { display: flex; }

.footer_newnov { width: 95%; margin: 0px auto; padding: 23px 0px 0px; }

