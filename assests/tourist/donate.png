@charset "utf-8";

._img, ._wid70 { border-radius: 15px; }

._city_bx, ._tvl_guid .w100, ._tvl_guid .w50, .reltv { position: relative; =
}

._tvl_guid ._t1, .view_btn a { font-size: 15px; }

.dateBg, .fct28 { text-transform: uppercase; }

._blog_img img, ._cir_img img, ._img img { object-fit: cover; }

._city_bx, ._des_bx, ._tvl_guid ._t3 a, .csrbtn, .seemore { text-decoration=
: none; }

* { box-sizing: border-box; }

a, abbr, acronym, address, applet, b, big, blockquote, body, caption, cente=
r, cite, code, dd, del, dfn, dl, dt, em, fieldset, font, form, h1, h2, h3, =
h4, h5, h6, html, iframe, img, input, ins, kbd, label, legend, li, object, =
ol, p, pre, q, s, samp, small, strike, strong, sub, sup, tt, u, ul, var { f=
ont-family: Poppins, sans-serif !important; }

section { float: left; width: 100%; }

img { max-width: 100%; }

.pdall20 { padding: 20px 0px; }

.pdbtm0 { padding-bottom: 0px; }

._innerWrap { width: 1200px; margin: auto; padding: 5px 0px; }

._toprflcont { display: flex; align-items: center; width: 100%; margin: 15p=
x 0px; flex-direction: column; justify-content: center; }

._hdrtxt, ._paratxt { width: auto; display: flex; align-items: center; }

._hdrtxt { font-size: 34px; font-weight: 700; justify-content: center; }

._paratxt { font-size: 18px; font-weight: 400; justify-content: center; mar=
gin: 10px 0px; }

._city_bx, .view_btn { display: flex; align-items: center; }

.view_btn { width: 100%; justify-content: center; margin: 15px 0px; }

.view_btn a { background: rgb(32, 147, 239); padding: 5px 20px; color: rgb(=
255, 255, 255); border-radius: 50px; cursor: pointer; font-weight: 500; }

._city_bx:hover, ._img img, ._prodbox { border-radius: 10px; }

._hotlcity { background: url("https://images.emtcontent.com/desk-img/bg-wor=
ld-map.jpg") center top / 90% auto no-repeat; width: 100%; padding: 20px 0p=
x; margin: 0px; }

._img, ._img img { height: 55px; width: 55px; }

._city_bx, ._city_bx:hover { padding: 5px; cursor: pointer; }

.dgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; m=
argin: 30px 0px; }

._city_bx { max-width: 90%; color: unset; }

._img, .iconcf2 { display: flex; align-items: center; }

._city_bx:hover { background: rgb(236, 245, 254); }

._city_bx a { position: absolute; bottom: 2px; right: 0px; display: none; }

._img { margin-right: 15px; }

._igtxt, ._wid70 { flex-direction: column; }

._igtxt { display: flex; justify-content: space-between; }

._c_nm { font-size: 20px; font-weight: 500; margin-bottom: 5px; }

._count, ._tvl_guid ._t1, .bg3 ._t1m, .fct14, .fct28, .newsbox h2 { font-we=
ight: 600; }

._count { font-size: 18px; margin: auto 0px; color: rgb(32, 147, 239); }

.cstwid { width: 74% !important; }

.cstwid2 { width: 24%; }

.bgref { background-image: linear-gradient(to right, rgb(255, 125, 131), rg=
b(210, 0, 60)); color: rgb(255, 255, 255); display: flex; border-radius: 12=
px; padding: 10px 15px !important; }

.fct14 { font-size: 14px; }

.fct28 { font-size: 22px; }

.pdte, .tncfr { font-size: 11px; }

._tvl_guid .new50 { width: 76%; }

.iconcf2 { min-width: 38px; margin-left: 10px; }

._tvl_guid, ._tvl_guid .w50 { align-items: center; display: flex; }

.tncfr { position: absolute; right: 38px; bottom: 10px; }

.bg3 ._t2 ul { padding-top: 5px; padding-right: 20px; padding-left: 20px; m=
argin: 0px; font-size: 13px; list-style-type: circle; padding-bottom: 0px !=
important; }

._tvl_guid { justify-content: space-between; }

._tvl_guid .w50 { border-radius: 30px 5px 5px; padding: 10px 15px; flex-dir=
ection: row; border: 0px; box-shadow: rgba(0, 0, 0, 0.1) 0px 0px 5px; width=
: 49%; background: url("https://images.emtcontent.com/desk-img/side-c.svg")=
 -17% 93% no-repeat rgb(255, 255, 255); }

._tvl_guid .w100 { border-radius: 12px; padding: 6px 15px; display: flex; a=
lign-items: center; flex-direction: row; border: 0px; }

._tvl_guid ._ico { width: 105px; margin-right: 10px; }

._tvl_guid ._iconvr2 { width: 75px; margin-left: 10px; }

._tvl_guid ._txtnw { width: 82%; margin-left: auto; }

._tvl_guid ._t3, .newsbox h2 { font-size: 13px; }

._tvl_guid ._t2 { font-size: 13px; margin: 2px 0px; }

._tvl_guid ._t3 a { color: rgb(32, 147, 239); }

._tvl_guid ._t3 a:hover { text-decoration: underline; color: rgb(32, 147, 2=
39); }

.bg3 { background-image: linear-gradient(to right, rgb(118, 198, 245), rgb(=
98, 172, 235), rgb(49, 210, 194), rgb(18, 194, 159)); color: rgb(255, 255, =
255); padding: 10px 30px !important; }

._wid30, ._wid70 { box-shadow: rgba(0, 0, 0, 0.1) 0px 0px 5px; padding: 15p=
x; display: flex; background: rgb(255, 255, 255); position: relative; }

.bg3 ._t1m { font-size: 24px; margin-right: 10px; }

.bg3 ._t1s { font-size: 15px; }

._widflx { display: flex; align-items: flex-start; justify-content: space-b=
etween; width: 100%; }

._wid70 { width: 65%; margin-right: auto; border: 1px solid rgb(191, 227, 2=
55); }

._wid30 { width: 33%; margin-left: auto; border-radius: 15px; flex-directio=
n: column; border: 1px solid rgb(191, 227, 255); }

.newsbox, .wid100 { width: 100%; float: left; }

.newsbox { padding: 10px 0px; border-bottom: 1px solid rgb(213, 213, 213); =
display: flex; }

.htb350 { height: 338px; overflow: auto; padding: 0px 15px 0px 0px; }

#offr_pp, ._blr_url, .blockpage { overflow: hidden; }

.wid70 { width: 68%; float: left; }

.wid30 { width: 30%; float: right; }

.eb_widget_box, .grecaptcha-badge, .grecaptcha-logo, .morecontent span, .re=
ad-more-news { display: none; }

.emt_support .pro-icon-h, .morelink { display: block; }

.dateClm, .pdte { display: flex; align-items: center; }

.newsbox h2 { display: block; width: 100%; margin-bottom: 5px; }

.newsbox p { font-size: 12px; color: rgb(103, 102, 102); margin: auto; text=
-align: left; }

.pdte { color: rgb(103, 102, 102); float: left; width: 100%; }

.pdte img { margin-right: 5px; }

.read-more-news-label { width: 100%; float: left; text-align: left; font-si=
ze: 12px; color: rgb(32, 147, 239); cursor: pointer; margin-top: 5px; }

.htb350 .newsbox:last-child { border: 0px; }

.htb350::-webkit-scrollbar { width: 2px; }

.htb350::-webkit-scrollbar-track { box-shadow: rgba(0, 0, 0, 0.3) 0px 0px 2=
px inset; }

.htb350::-webkit-scrollbar-thumb { background-color: rgb(32, 147, 239); out=
line: rgb(32, 147, 239) solid 1px; }

.read-more-content { max-height: 0px; overflow: hidden; transition: max-hei=
ght 0.5s; }

.read-more-news-label::after { content: "More"; display: inline-block; }

.read-more-news:checked + .read-more-content { display: block; max-height: =
1000px; }

.read-more-news:checked + .read-more-content + .read-more-news-label::after=
 { content: "Less"; }

._news_container { padding: 0px; background: rgb(255, 255, 255); border: 0p=
x; position: relative; width: 100%; margin-top: 10px; }

.dateClm { flex-direction: column; justify-content: flex-start; margin-righ=
t: 10px; margin-top: 4px; background: url("https://images.emtcontent.com/de=
sk-img/calendar-news.svg") 0px 0px / 100% auto no-repeat; min-width: 50px; =
}

.dateBg, .mnthBg { margin: 0px; font-weight: 600; }

.mnthBg { font-size: 11px; color: rgb(255, 255, 255); padding: 6px 0px 0px;=
 line-height: unset; background: unset; }

.dateBg { font-size: 20px; color: rgb(0, 0, 0); }

.clr { clear: both; }

._topdes_news { width: 100%; padding: 0px; }

._grid_4 { display: grid; grid-template-columns: repeat(5, 1fr); gap: 30px;=
 margin: 30px auto 15px; width: 80%; }

._des_bx { width: 100%; display: flex; align-items: center; flex-direction:=
 column; cursor: pointer; }

._cir_img, ._cir_img img { width: 60px; height: 60px; }

._cir_img { margin: auto; }

._cir_img img { border-radius: 50px; }

._blog_bdy, ._blog_box, ._blog_img, ._blog_img img { border-radius: 15px; }

._des_txt { font-size: 17px; margin-top: 10px; width: 100%; text-align: cen=
ter; font-weight: 500; color: rgb(0, 0, 0); }

._des_bx:hover ._des_txt { color: rgb(32, 147, 239); }

._blog_box { position: relative; height: 220px; }

._blog_bdy, ._blog_typ { position: absolute; color: rgb(255, 255, 255); }

._blog_img, ._blog_img img { width: 100%; height: 220px; }

._blog_bdy { top: 0px; height: 100%; background: rgba(0, 0, 0, 0.3); width:=
 100%; padding: 15px; }

._blog_typ { width: auto; top: 10px; left: 15px; background: rgb(0, 0, 0); =
padding: 3px 12px; font-size: 12px; font-weight: 500; border-radius: 26px; =
z-index: 2; }

._blog_ttl, ._divttl, .seemore { font-weight: 600; }

._blog_ttl { font-size: 15px; }

._blog_para { font-size: 12px; margin-top: 5px; }

._blog_url, ._blog_url:hover, ._blr_url { bottom: 0px; padding: 12px 15px; =
font-size: 14px; left: 0px; position: absolute; width: 100%; }

._blog_url { z-index: 2; background: url("https://images.emtcontent.com/des=
k-img/left-wht-arrw.svg") 92% 50% no-repeat; }

._blog_url:hover { z-index: 2; background: url("https://images.emtcontent.c=
om/desk-img/left-wht-arrw.svg") 94% 50% no-repeat; }

._blr_url { border-radius: 0px 0px 15px 15px; z-index: 1; background: 0px 0=
px; backdrop-filter: blur(15px); }

._blog_txt { padding: 15px; position: absolute; bottom: 38px; width: 100%; =
z-index: 2; color: rgb(255, 255, 255); }

._divbox, ._mflxop { position: relative; display: flex; }

