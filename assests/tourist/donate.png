body.bw .errorfrmsrc::before { border-bottom-color: var(--blackclr); }

body.bw .eb_widget_chat_box_header, body.bw .f16 .flag, body.bw .eb-me, bod=
y.bw .eb-you, body.bw .widget_confirm_clear, body.bw .topCityhd, body.bw .c=
heck-bxgroup { filter: grayscale(100%); }

body.bw #contrastToggle img { filter: none !important; }

body.bw ._btnLogin:hover { color: var(--whitebg); background-color: var(--b=
annerbg); }

body.bw ._btnLogin { color: var(--whitebg); background-color: var(--blackcl=
r); }

body.bw ._resnd, body.bw .timer, body.bw ._logreff, body.bw ._des_bx:hover =
._des_txt { color: var(--blackclr); }

body.bw .addctybtn:hover { background-color: var(--lightgrey); }

body.bw .emt-link { color: var(--blackclr); }

body.bw .exclusiveoff, body.bw .roud-m1::before { filter: grayscale(100%); }
