coration: none; }

.mail_bx { background-color: rgb(56, 56, 56); border-radius: 4px; padding: =
10px 16px 10px 11px; display: flex; flex-direction: row; }

.mail_bx-icn { vertical-align: middle; width: 22px; height: 14px; margin-ri=
