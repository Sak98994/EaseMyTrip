ign-content: space-between; position: relative; font-size: 14px; border-bot=
tom: 0.2px solid rgb(74, 71, 71); }

.leftfotmenu li:hover { background: rgb(47, 47, 47); }

.leftfotmenu li a { color: rgb(255, 255, 255); text-decoration: none; }

