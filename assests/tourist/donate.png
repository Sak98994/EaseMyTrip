Content-Transfer-Encoding: quoted-printable
Content-Location: https://css.emtcontent.com/new-search-engine/new-clandr-home-v1.css?v=3f

@charset "utf-8";

* { box-sizing: border-box; }

ul { list-style-type: none; }

body { font-family: inherit; margin: 0px; padding: 0px; }

.main { width: 100%; float: left; margin-left: 7px; }

.box { width: 355px; margin: 0px auto; z-index: 9999; top: -23px; position:=
 absolute; box-shadow: rgb(142, 135, 135) -5px 0px 5px -5px; height: 420px;=
 background-color: rgb(255, 255, 255); border-bottom: 1px solid rgb(204, 20=
4, 204); padding: 10px 10px 11px 5px; border-radius: 16px 0px 0px 16px; ove=
rflow: hidden; }

.month { height: 40px; width: 100%; border-radius: 0px; background: rgb(255=
, 255, 255) !important; }

.month-sec { height: 40px; width: 100%; border-radius: 0px; background: rgb=
(255, 255, 255) !important; }

.month1 { width: 10%; float: left; text-align: center; }

.month1 img { margin-top: 7px; cursor: pointer; }

.month2 { width: 90%; float: left; font-size: 14px; color: rgb(0, 0, 0); te=
xt-align: center; line-height: 40px; text-transform: uppercase; font-weight=
: 600; }

.month3 { width: 10%; float: right; text-align: center; }

.month3 img { margin-top: 7px; cursor: pointer; }

.month ul { margin: 0px; padding: 0px; font-size: 41px; }

.month ul li { color: rgb(255, 255, 255); font-size: 13px; text-transform: =
uppercase; letter-spacing: 3px; }

.month .prev { float: left; padding-top: 10px; }

.month .next { float: right; padding-top: 10px; }

.weekdays { width: 100%; float: left; font-size: 15px; margin-bottom: 10px;=
 }

.weekdays ul { margin: 0px; padding: 0px; display: flex; gap: 0px 1px; }

.weekdays li { display: inline-block; width: 14%; color: rgb(122, 122, 122)=
; height: 30px; line-height: 30px; text-align: center; font-family: Poppins=
; font-weight: 500; font-size: 12px; }

.days { width: 100%; float: left; background: rgb(255, 255, 255); margin: 0=
px; padding: 0px 1%; }

.days:last-child { padding-bottom: 5px; border-radius: 4px; }

.out-date { color: rgb(220, 220, 220); }

.null-date { color: rgb(220, 220, 220); }

.days ul { margin: 0px; padding: 0px; display: flex; gap: 1px; }

.days li { list-style-type: none; float: left; width: 14%; text-align: cent=
er; font-size: 14px; color: rgb(0, 0, 0); height: 49px; list-style-position=
: inside; font-weight: 400; cursor: pointer; font-family: Poppins; padding-=
top: 0px; margin-top: 1px; margin-bottom: 1px; display: flex; flex-flow: co=
lumn; justify-content: center; }

.days ul li span { color: rgb(45, 116, 177); display: block; float: left; t=
ext-align: center; font-size: 10px; width: 100%; font-weight: 300; }

