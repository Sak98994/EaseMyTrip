th: 20%; }

.leftfotmenu li:last-child { border-bottom-width: medium; border-bottom-sty=
le: none; border-bottom-color: currentcolor; }

.iconsocialimg { width: 25px; margin: 2px 5px 0px 0px; }

.container_newsletter { width: 99%; padding: 20px; display: flex; align-ite=
ms: center; background: rgba(89, 89, 89, 0.25); margin: 25px auto 10px 0px;=
 border-radius: 7px; }

.content_newsletter { width: 398px; height: 40px; box-shadow: rgba(0, 0, 0,=
 0.2) 2px 4px 10px; border-radius: 60px; overflow: hidden; margin-left: 36p=
x; }

.subscribe__title { font-size: 17px; color: rgb(255, 255, 255); font-weight=
: 600; margin-bottom: 3px; }

.subscribe__copy { font-size: 13px; color: rgb(255, 255, 255); font-weight:=
 500; }

.subscription { position: relative; width: 100%; height: 100%; }

.subscription .add-email { position: absolute; top: 0px; left: 0px; width: =
100%; height: 100%; border-width: medium; border-style: none; border-color:=
 currentcolor; border-image: none; outline: none; padding: 0px 0px 0px 20px=
; }

.subscription .submit-email { position: absolute; top: 0px; right: 0px; hei=
ght: calc(100% - 2px); width: 112px; border-width: medium; border-style: no=
ne; border-color: currentcolor; border-image: none; border-radius: 60px; ou=
tline: none; margin: 1px; padding: 0px 20px; cursor: pointer; background: r=
gb(32, 147, 239); color: rgb(255, 255, 255); transition: width 0.35s ease-i=
n-out, background 0.35s ease-in-out; text-transform: uppercase; font-weight=
: 600; letter-spacing: 0.5px; }

.subscription.done .submit-email { width: calc(100% - 2px); background: rgb=
(0, 177, 68); }

.subscription .submit-email .before-submit, .subscription .submit-email .af=
ter-submit { position: absolute; top: 0px; left: 0px; width: 100%; height: =
100%; text-align: center; line-height: 38px; transition: visibility 0.35s e=
ase-in-out, opacity 0.35s ease-in-out; }

.subscription.done .submit-email .before-submit, .subscription:not(.done) .=
submit-email .after-submit { visibility: hidden; opacity: 0; }

.subscription .submit-email .after-submit { transition-delay: 0.35s; }

.subscription:not(.done) .submit-email .before-submit, .subscription.done .=
submit-email .after-submit { visibility: visible; opacity: 1; }

.lastelement { list-style: none; margin: 0px; padding: 7px 12px; align-item=
s: center; cursor: pointer; display: flex; align-content: space-between; po=
sition: relative; font-size: 14px; text-decoration: none; color: rgb(255, 2=
55, 255) !important; }

.ftnovact { border-radius: 5px 0px 0px 5px; background: rgb(32, 147, 239) !=
important; }

.f-para { display: block; width: 100%; color: rgb(255, 255, 255); font-size=
: 16px; margin-bottom: 15px; font-weight: 600; }

.ftnovact::after { border-right: 23px solid rgb(32, 147, 239); border-botto=
m: 23px solid transparent; position: absolute; content: ""; right: -11px; t=
op: 4px; transform: rotate(45deg); display: block; }

