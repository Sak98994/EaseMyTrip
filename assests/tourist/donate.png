------MultipartBoundary--iZhr2LhWKv1TfUEkVg3r5mOXckS0PiJjmK8DgYNo9Q----
Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: https://css.emtcontent.com/common/emtpro.css?v=88.7

@charset "utf-8";

body, p { margin: 0px; padding: 0px; }

:root { --darkblue_pro: #121860; --blue_pro: #002287; --lightblue_pro: #127=
3df; --white_pro: #ffffff; --grey_pro: #e2e2e2; --golden_pro: #BB9208; --li=
ghtbg_pro: #f1f7fa; --bgblue_pro: #07053D; --black_pro: #000000; --yellowbg=
_pro: #f5c842; --yellow_pro: #041870; --bglgpink_pro: #FFF5EA; }

.clr { clear: both; }

.color_pro { color: rgb(255, 197, 0); }

.pro-icon-h { width: 50px; top: -5px; position: absolute; right: 315px; dis=
play: none; }

