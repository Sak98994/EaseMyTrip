------MultipartBoundary--iZhr2LhWKv1TfUEkVg3r5mOXckS0PiJjmK8DgYNo9Q----
Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: https://css.emtcontent.com/loginslides/loginslides-com.css?new

@charset "utf-8";

._crosslog { right: -30px; top: -130px; }

.logbgA .slide-logbox, .logbgB .slide-logbox, .logbgC .slide-logbox, .logbg=
D .slide-logbox { display: none !important; }

.logbgA { background: url("https://css.emtcontent.com/loginslides/flight-em=
tncf.webp"); }

.logbgB { background: url("https://css.emtcontent.com/loginslides/flight-em=
tfirst.webp"); }

.logbgC { background: url("https://css.emtcontent.com/loginslides/hotel-in.=
webp"); }

.logbgD { background: url("https://css.emtcontent.com/loginslides/bus-in.we=
bp"); }

.logbgA, .logbgB, .logbgC, .logbgD { height: 140px; background-size: cover;=
 background-repeat: no-repeat; background-position: 20% -10px; }

._loglft { margin-bottom: -30px !important; }

.st-slider .labels { bottom: 35px !important; }

@keyframes bullet {=20
  0%, 25% { background: rgb(255, 255, 255); }
  100%, 25.5% { background: gray; }
}

#slide1:checked ~ div .fake-radio .radio-btn:first-child, #slide2:checked ~=
 div .fake-radio .radio-btn:nth-child(2), #slide3:checked ~ div .fake-radio=
 .radio-btn:nth-child(3), #slide4:checked ~ div .fake-radio .radio-btn:nth-=
child(4) { background: rgb(255, 255, 255); }

@media only screen and (max-width: 699px) {
  ._crosslog { right: 45%; top: -55px; }
}
