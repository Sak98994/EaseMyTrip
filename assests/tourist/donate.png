, 79, 95); line-height: 1.7; animation: 0.7s cubic-bezier(0.22, 1, 0.36, 1)=
 1.2s 1 normal both running evaPop; }

.eva_intro_card .start-btn { margin-top: 28px; padding: 13px 34px; border-r=
adius: 50px; border-width: medium; border-style: none; border-color: curren=
tcolor; border-image: none; background: linear-gradient(96.36deg, rgb(12, 1=
12, 204) 4.3%, rgb(32, 147, 239) 84.07%); color: rgb(255, 255, 255); font-f=
amily: Sora, sans-serif; font-size: 14px; font-weight: 600; cursor: pointer=
; box-shadow: rgba(32, 147, 239, 0.66) 0px 8px 28px; transition: transform =
0.2s, box-shadow 0.2s; animation: 0.7s cubic-bezier(0.22, 1, 0.36, 1) 1.5s =
1 normal both running evaPop; position: relative; overflow: hidden; }

.eva_intro_card .start-btn::after { content: ""; position: absolute; inset:=
 0px; background: linear-gradient(135deg, rgba(255, 255, 255, 0.18), transp=
arent); }

.eva_intro_card .start-btn:hover { transform: translateY(-2px); box-shadow:=
 rgba(32, 147, 239, 0.79) 0px 14px 36px; }

.eva_intro_card .start-btn:active { transform: scale(0.97); }

@keyframes evaPop {=20
  0% { opacity: 0; transform: translateY(18px) scale(0.9); }
  100% { opacity: 1; transform: none; }
}

.eva_intro_card .blush { position: absolute; bottom: 0px; left: 0px; right:=
 0px; height: 180px; background: linear-gradient(to top, rgba(32, 147, 239,=
 0.27), rgba(0, 0, 0, 0)); pointer-events: none; border-radius: 0px 0px 20p=
x 20px; }

.eva_intro_card .particles { position: absolute; inset: 0px; pointer-events=
: none; overflow: hidden; border-radius: 20px; }

.eva_intro_card .particles .p { position: absolute; border-radius: 50%; opa=
city: 0; animation: 5s ease-in-out 0s infinite normal none running evaPFly;=
 }

@keyframes evaPFly {=20
  0% { opacity: 0; transform: translateY(0px) scale(0); }
  20% { opacity: 0.7; }
  100% { opacity: 0; transform: translateY(-180px) scale(1.5); }
}

@media only screen and (max-width: 499px) {
  .chat-box { width: 100%; right: 0px; bottom: 0px; border-radius: 18px 18p=
x 0px 0px; }
  .body_scroller { height: calc(-200px + 100vh); max-height: none; }
  .menu { grid-template-columns: repeat(2, 1fr); }
  .chat_box_button_prnt { right: 10px; bottom: 10px; }
  .eva_intro_card { width: calc(100% - 20px); right: 10px; bottom: 10px; mi=
n-height: 400px; }
}
